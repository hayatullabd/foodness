    <style>
        .savings-animated-pill {
            background-color: #ecfdf5;
            border: 1.5px solid #10b981;
            animation: savingsPulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        }
        @keyframes savingsPulse {
            0%, 100% {
                box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.45);
                border-color: #10b981;
                transform: scale(1);
            }
            50% {
                box-shadow: 0 0 0 6px rgba(16, 185, 129, 0);
                border-color: #059669;
                transform: scale(1.03);
            }
        }
    </style>
@endsection

@push('scripts')
    <script>
        (() => {
            const root = document.querySelector('[data-product-gallery]');
            const main = root?.querySelector('[data-gallery-main]');
            const thumbs = Array.from(root?.querySelectorAll('[data-gallery-thumb]') || []);
            const productName = @json($product->name);
            const productPrice = {{ (float) $product->price }};
            const productUrl = @json(url()->current());
            const activeThumbBorder = @json($thumbBorderColor);

            // Tab switching
            const descBtn = document.getElementById('tab-btn-description');
            const deliveryBtn = document.getElementById('tab-btn-delivery');
            const descPanel = document.getElementById('tab-panel-description');
            const deliveryPanel = document.getElementById('tab-panel-delivery');
            const themePrimary = @json($themePrimary);

            function activateTab(btn, panel, otherBtn, otherPanel) {
                if (! btn || ! panel) return;
                panel.classList.remove('hidden');
                panel.classList.add('block');
                btn.style.backgroundColor = themePrimary;
                btn.classList.add('text-white');
                btn.classList.remove('bg-white', 'text-slate-700', 'border', 'border-slate-300');

                if (otherBtn && otherPanel) {
                    otherPanel.classList.add('hidden');
                    otherPanel.classList.remove('block');
                    otherBtn.style.backgroundColor = '';
                    otherBtn.classList.remove('text-white');
                    otherBtn.classList.add('bg-white', 'text-slate-700', 'border', 'border-slate-300');
                }
            }

            descBtn?.addEventListener('click', () => {
                activateTab(descBtn, descPanel, deliveryBtn, deliveryPanel);
            });

            deliveryBtn?.addEventListener('click', () => {
                activateTab(deliveryBtn, deliveryPanel, descBtn, descPanel);
            });

            // Gallery Render
            let currentGalleryIndex = 0;

            const renderMain = (type, src) => {
                if (! main || ! src) return;

                // Keep discount badge and zoom & arrows if present
                const badge = document.getElementById('product-discount-badge');
                const zoomBtn = document.getElementById('btn-gallery-zoom');
                const prevBtn = document.getElementById('btn-gallery-prev');
                const nextBtn = document.getElementById('btn-gallery-next');

                main.innerHTML = '';
                if (badge) main.appendChild(badge);
                if (zoomBtn) main.appendChild(zoomBtn);
                if (prevBtn) main.appendChild(prevBtn);
                if (nextBtn) main.appendChild(nextBtn);

                if (type === 'youtube') {
                    const iframe = document.createElement('iframe');
                    iframe.src = `${src}?rel=0`;
                    iframe.title = `${productName} video`;
                    iframe.className = 'h-full w-full';
                    iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
                    iframe.allowFullscreen = true;
                    iframe.setAttribute('data-gallery-main-media', '');
                    main.appendChild(iframe);
                    return;
                }

                if (type === 'video') {
                    const video = document.createElement('video');
                    video.src = src;
                    video.controls = true;
                    video.playsInline = true;
                    video.className = 'h-full w-full object-contain';
                    video.setAttribute('data-gallery-main-media', '');
                    main.appendChild(video);
                    return;
                }

                const img = document.createElement('img');
                img.src = src;
                img.alt = productName;
                img.className = 'h-full w-full object-contain cursor-pointer transition-transform duration-300 hover:scale-[1.02]';
                img.setAttribute('data-gallery-main-media', '');
                img.id = 'product-main-image-element';
                img.addEventListener('click', () => openLightbox(src));
                main.appendChild(img);
            };

            const selectThumbnail = (index) => {
                if (thumbs.length === 0) return;
                if (index < 0) index = thumbs.length - 1;
                if (index >= thumbs.length) index = 0;

                currentGalleryIndex = index;
                const activeThumb = thumbs[index];
                if (! activeThumb) return;

                thumbs.forEach((t) => {
                    t.style.borderColor = '#E5E7EB';
                });
                activeThumb.style.borderColor = activeThumbBorder;
                activeThumb.scrollIntoView?.({ behavior: 'smooth', block: 'nearest', inline: 'center' });

                renderMain(activeThumb.getAttribute('data-media-type'), activeThumb.getAttribute('data-media-src'));
            };

            thumbs.forEach((thumb, idx) => {
                thumb.addEventListener('click', () => selectThumbnail(idx));
            });

            document.getElementById('btn-gallery-prev')?.addEventListener('click', (e) => {
                e.stopPropagation();
                selectThumbnail(currentGalleryIndex - 1);
            });

            document.getElementById('btn-gallery-next')?.addEventListener('click', (e) => {
                e.stopPropagation();
                selectThumbnail(currentGalleryIndex + 1);
            });

            // Lightbox Modal
            const lightboxModal = document.getElementById('gallery-lightbox-modal');
            const lightboxImg = document.getElementById('lightbox-modal-img');
            const lightboxClose = document.getElementById('lightbox-close-btn');

            function openLightbox(src) {
                if (! lightboxModal || ! lightboxImg) return;
                lightboxImg.src = src;
                lightboxModal.classList.remove('hidden');
            }

            function closeLightbox() {
                if (! lightboxModal) return;
                lightboxModal.classList.add('hidden');
            }

            document.getElementById('btn-gallery-zoom')?.addEventListener('click', () => {
                const curImg = document.getElementById('product-main-image-element');
                if (curImg && curImg.src) openLightbox(curImg.src);
            });

            document.getElementById('product-main-image-element')?.addEventListener('click', (e) => {
                openLightbox(e.target.src);
            });

            lightboxClose?.addEventListener('click', closeLightbox);
            lightboxModal?.addEventListener('click', (e) => {
                if (e.target === lightboxModal) closeLightbox();
            });

            // Quantity buttons & Real-time Price Update
            const qtyInput = document.querySelector('[data-qty-input]');
            const btnDec = document.getElementById('btn-qty-decrement');
            const btnInc = document.getElementById('btn-qty-increment');

            const updatePriceByQty = () => {
                const currentVar = typeof findVariant === 'function' ? findVariant() : null;
                const basePrice = currentVar ? currentVar.price : productPrice;
                const baseCompare = currentVar ? (currentVar.compare_at_price || 0) : {{ (float) ($product->compare_at_price ?? 0) }};
                const qty = parseInt(qtyInput?.value, 10) || 1;

                if (priceEl) {
                    priceEl.textContent = '৳' + toBnDigits(Math.round(basePrice * qty).toLocaleString('en-US'));
                }
                if (comparePriceEl) {
                    if (baseCompare > basePrice) {
                        comparePriceEl.textContent = '৳' + toBnDigits(Math.round(baseCompare * qty).toLocaleString('en-US'));
                        comparePriceEl.classList.remove('hidden');
                    } else {
                        comparePriceEl.textContent = '';
                        comparePriceEl.classList.add('hidden');
                    }
                }
                if (savingsBox && savingsAmountEl) {
                    const diff = (baseCompare - basePrice) * qty;
                    if (diff > 0) {
                        savingsAmountEl.textContent = '৳' + toBnDigits(Math.round(diff).toLocaleString('en-US'));
                        savingsBox.classList.remove('hidden');
                    } else {
                        savingsBox.classList.add('hidden');
                    }
                }
                updateWhatsAppLink();
            };

            btnDec?.addEventListener('click', () => {
                if (! qtyInput || qtyInput.disabled) return;
                const val = parseInt(qtyInput.value, 10) || 1;
                if (val > 1) {
                    qtyInput.value = val - 1;
                    updatePriceByQty();
                }
            });

            btnInc?.addEventListener('click', () => {
                if (! qtyInput || qtyInput.disabled) return;
                const val = parseInt(qtyInput.value, 10) || 1;
                const max = parseInt(qtyInput.max, 10) || 999;
                if (val < max) {
                    qtyInput.value = val + 1;
                    updatePriceByQty();
                }
            });

            qtyInput?.addEventListener('input', () => {
                updatePriceByQty();
            });

            // WhatsApp link generator
            const waBtn = document.getElementById('btn-whatsapp-order');
            const waNumber = @json($whatsAppCleanNumber);
            const waRawTemplate = @json($whatsAppMsgTemplate);

            function updateWhatsAppLink() {
                if (! waBtn || ! waNumber) return;
                const currentVar = typeof findVariant === 'function' ? findVariant() : null;
                const qty = parseInt(qtyInput?.value, 10) || 1;
                const currentPrice = currentVar ? currentVar.price : productPrice;
                const currentSku = currentVar ? (currentVar.sku || @json($product->sku)) : @json($product->sku);
                const varName = currentVar ? currentVar.name : '';

                let message = waRawTemplate
                    .replace('{product_name}', productName + (varName ? ' (' + varName + ')' : ''))
                    .replace('{price}', (currentPrice * qty) + '৳')
                    .replace('{sku}', currentSku || '')
                    .replace('{url}', productUrl);

                message += `\nপরিমাণ: ${qty} টি`;

                waBtn.href = `https://wa.me/${waNumber}?text=${encodeURIComponent(message)}`;
            }

            // Variant Selector Logic
            const variants = @json($variantsJson);
            const attrButtons = document.querySelectorAll('.variant-attr-btn');
            const variantInput = document.querySelector('[data-variant-id-input]');
            const priceEl = document.querySelector('[data-product-price]');
            const comparePriceEl = document.querySelector('[data-product-compare-price]');
            const stockBadge = document.querySelector('[data-product-stock-badge]');
            const skuEl = document.querySelector('[data-product-sku]');
            const addToBagBtn = document.querySelector('[data-add-to-bag]');
            const buyNowBtn = document.querySelector('[data-buy-now]');
            const deliveryBadgeWrap = document.getElementById('product-delivery-badge-wrap');
            const discountBadgeEl = document.getElementById('product-discount-badge');
            const savingsBox = document.querySelector('[data-product-savings]');
            const savingsAmountEl = document.querySelector('[data-product-savings-amount]');

            const toBnDigits = (val) => {
                if (val === null || val === undefined) return '';
                const bnNums = ['০','১','২','৩','৪','৫','৬','৭','৮','৯'];
                return String(val).replace(/\d/g, (d) => bnNums[d]);
            };

            const truckIcon = `<svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 0 0-3.213-9.193 2.056 2.056 0 0 0-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 0 0-10.026 0 1.106 1.106 0 0 0-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" /></svg>`;

            const currentSelection = {};

            const updateActiveButtons = () => {
                attrButtons.forEach((btn) => {
                    const attr = btn.getAttribute('data-attr');
                    const val = btn.getAttribute('data-val');
                    const active = currentSelection[attr] === val;

                    if (active) {
                        btn.style.backgroundColor = themePrimary;
                        btn.classList.add('text-white', 'border-transparent');
                        btn.classList.remove('bg-white', 'text-slate-800', 'border-slate-200');
                    } else {
                        btn.style.backgroundColor = '';
                        btn.classList.remove('text-white', 'border-transparent');
                        btn.classList.add('bg-white', 'text-slate-800', 'border-slate-200');
                    }
                });

                Object.keys(currentSelection).forEach((attr) => {
                    const label = document.querySelector(`[data-selected-attr-label="${attr}"]`);
                    if (label) {
                        label.textContent = currentSelection[attr];
                    }
                });
            };

            function findVariant() {
                if (! Array.isArray(variants) || variants.length === 0) return null;
                const match = variants.find((v) => {
                    const vAttrs = v.attributes || {};
                    return Object.keys(currentSelection).every((key) => {
                        return String(vAttrs[key] || '') === String(currentSelection[key]);
                    });
                });
                return match || variants[0];
            }

            const syncSelection = () => {
                const current = findVariant();
                if (! current) return;

                if (variantInput) {
                    variantInput.value = current.id;
                }

                if (priceEl && current.price_formatted) {
                    updatePriceByQty();
                }

                if (comparePriceEl) {
                    if (current.compare_at_price_formatted && current.compare_at_price > current.price) {
                        comparePriceEl.textContent = current.compare_at_price_formatted;
                        comparePriceEl.classList.remove('hidden');
                    } else {
                        comparePriceEl.textContent = '';
                        comparePriceEl.classList.add('hidden');
                    }
                }

                if (discountBadgeEl && current.compare_at_price && current.compare_at_price > current.price) {
                    const pct = Math.round(((current.compare_at_price - current.price) / current.compare_at_price) * 100);
                    discountBadgeEl.textContent = `${pct}% Off!`;
                    discountBadgeEl.classList.remove('hidden');
                }

                if (skuEl && current.sku) {
                    skuEl.textContent = current.sku;
                }

                if (stockBadge) {
                    if (current.stock > 0) {
                        stockBadge.innerHTML = `<span class="h-1.5 w-1.5 rounded-full bg-emerald-600"></span> <span>স্টকে আছে</span>`;
                        stockBadge.className = 'inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-[11px] sm:text-xs font-bold bg-emerald-50 text-emerald-800 ring-1 ring-emerald-600/20';
                    } else {
                        stockBadge.innerHTML = `<span class="h-1.5 w-1.5 rounded-full bg-rose-600"></span> <span>স্টক শেষ</span>`;
                        stockBadge.className = 'inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-[11px] sm:text-xs font-bold bg-rose-50 text-rose-800 ring-1 ring-rose-600/20';
                    }
                }

                if (qtyInput) {
                    qtyInput.max = Math.max(1, current.stock);
                    qtyInput.disabled = current.stock <= 0;
                    if (parseInt(qtyInput.value, 10) > current.stock) {
                        qtyInput.value = Math.max(1, current.stock);
                    }
                }

                if (addToBagBtn) {
                    addToBagBtn.disabled = current.stock <= 0;
                }

                if (buyNowBtn) {
                    buyNowBtn.disabled = current.stock <= 0;
                }

                if (current.image_url) {
                    renderMain('image', current.image_url);
                    thumbs.forEach((thumb, idx) => {
                        if (thumb.getAttribute('data-media-src') === current.image_url) {
                            selectThumbnail(idx);
                        }
                    });
                }

                // Delivery badge sync for variant
                if (deliveryBadgeWrap) {
                    const delType = current.delivery_charge_type || 'default';
                    const isProductFree = @json((bool) $product->free_delivery);
                    const defaultCharge = @json($product->delivery_charge !== null ? (float) $product->delivery_charge : null);

                    if (delType === 'free' || (delType === 'default' && isProductFree)) {
                        deliveryBadgeWrap.innerHTML = `
                            <span class="inline-flex items-center gap-1 rounded-full bg-emerald-100/90 border border-emerald-300 px-2.5 py-0.5 font-bold text-emerald-800 shadow-2xs">
                                ${truckIcon}
                                <span>ফ্রি ডেলিভারি</span>
                            </span>
                        `;
                        deliveryBadgeWrap.classList.remove('hidden');
                    } else if (delType === 'custom') {
                        const ins = current.custom_delivery_inside;
                        const out = current.custom_delivery_outside;
                        let text = 'কাস্টম ডেলিভারি';
                        if (ins !== null && ins !== undefined && out !== null && out !== undefined) {
                            text = `ডেলিভারি: ভেতরে ৳${toBnDigits(Math.round(ins))} / বাইরে ৳${toBnDigits(Math.round(out))}`;
                        } else if (ins !== null && ins !== undefined) {
                            text = `ডেলিভারি: ৳${toBnDigits(Math.round(ins))}`;
                        } else if (out !== null && out !== undefined) {
                            text = `ডেলিভারি: ৳${toBnDigits(Math.round(out))}`;
                        }
                        deliveryBadgeWrap.innerHTML = `
                            <span class="inline-flex items-center gap-1 rounded-full bg-blue-50 border border-blue-200 px-2.5 py-0.5 font-bold text-blue-800 shadow-2xs">
                                ${truckIcon}
                                <span>${text}</span>
                            </span>
                        `;
                        deliveryBadgeWrap.classList.remove('hidden');
                    } else if (defaultCharge !== null) {
                        deliveryBadgeWrap.innerHTML = `
                            <span class="inline-flex items-center gap-1 rounded-full bg-slate-100 border border-slate-300 px-2.5 py-0.5 font-bold text-slate-800 shadow-2xs">
                                ${truckIcon}
                                <span>ডেলিভারি চার্জ: ৳${toBnDigits(Math.round(defaultCharge))}</span>
                            </span>
                        `;
                        deliveryBadgeWrap.classList.remove('hidden');
                    } else {
                        deliveryBadgeWrap.innerHTML = '';
                        deliveryBadgeWrap.classList.add('hidden');
                    }
                }

                updateActiveButtons();
                updateWhatsAppLink();
            };

            if (Array.isArray(variants) && variants.length > 0) {
                const initialVariant = variants.find((v) => v.stock > 0) || variants[0];
                if (initialVariant && initialVariant.attributes) {
                    Object.assign(currentSelection, initialVariant.attributes);
                    syncSelection();
                }

                attrButtons.forEach((btn) => {
                    btn.addEventListener('click', () => {
                        const attr = btn.getAttribute('data-attr');
                        const val = btn.getAttribute('data-val');
                        currentSelection[attr] = val;
                        syncSelection();
                    });
                });
            } else {
                updateWhatsAppLink();
            }

            // Add to Cart button -> AJAX add without leaving page, updates bag instantly
            addToBagBtn?.addEventListener('click', async (e) => {
                e.preventDefault();
                const current = typeof findVariant === 'function' ? findVariant() : null;
                const variantId = current ? current.id : (variantInput?.value || null);
                const qty = parseInt(qtyInput?.value || '1', 10) || 1;

                addToBagBtn.disabled = true;
                const origHtml = addToBagBtn.innerHTML;
                addToBagBtn.innerHTML = '<span>যুক্ত হচ্ছে...</span>';

                try {
                    const csrf = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
                    const res = await fetch(@json(route('cart.store.modal')), {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Accept': 'application/json',
                            'X-CSRF-TOKEN': csrf,
                            'X-Requested-With': 'XMLHttpRequest',
                        },
                        body: JSON.stringify({
                            product_id: @json($product->id),
                            variant_id: variantId,
                            qty: qty,
                            buy_now: 0,
                        }),
                    });

                    const data = await res.json();
                    if (data.ok) {
                        // Update cart badge count in navbar & mobile bottom bar
                        if (window.StoreModal && typeof window.StoreModal.updateBadges === 'function') {
                            window.StoreModal.updateBadges(data.cart_count);
                        } else {
                            document.querySelectorAll('[data-cart-count-badge], [data-cart-count-badge-mobile]').forEach(b => {
                                b.textContent = data.cart_count;
                                b.classList.toggle('hidden', data.cart_count <= 0);
                            });
                        }

                        // Trigger tracking
                        if (typeof window.triggerAddToCartTracking === 'function' && data.tracked_event) {
                            window.triggerAddToCartTracking(data.tracked_event, {
                                id: @json((string) $product->id),
                                name: @json($product->name),
                                category: @json($product->category?->name ?? ''),
                            });
                        }

                        // Success feedback
                        window.showToast(data.message || 'পণ্যটি ব্যাগে যোগ হয়েছে।', 'success');
                        addToBagBtn.innerHTML = '<span>✓ ব্যাগে যোগ হয়েছে</span>';
                        setTimeout(() => {
                            addToBagBtn.innerHTML = origHtml;
                            addToBagBtn.disabled = false;
                        }, 1800);
                    } else {
                        window.showToast(data.message || 'পণ্যটি ব্যাগে যোগ করা সম্ভব হয়নি।', 'error');
                        addToBagBtn.disabled = false;
                        addToBagBtn.innerHTML = origHtml;
                    }
                } catch (err) {
                    addToBagBtn.disabled = false;
                    addToBagBtn.innerHTML = origHtml;
                    document.getElementById('single-product-form')?.submit();
                }
            });

            // Buy Now button interception -> triggers checkout modal
            buyNowBtn?.addEventListener('click', async (e) => {
                e.preventDefault();
                const current = typeof findVariant === 'function' ? findVariant() : null;
                const variantId = current ? current.id : (variantInput?.value || null);
                const qty = parseInt(qtyInput?.value || '1', 10) || 1;

                buyNowBtn.disabled = true;
                const origHtml = buyNowBtn.innerHTML;
                buyNowBtn.innerHTML = '<span>অর্ডার প্রক্রিয়া হচ্ছে...</span>';

                try {
                    const csrf = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
                    const res = await fetch(@json(route('cart.store.modal')), {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Accept': 'application/json',
                            'X-CSRF-TOKEN': csrf,
                            'X-Requested-With': 'XMLHttpRequest',
                        },
                        body: JSON.stringify({
                            product_id: @json($product->id),
                            variant_id: variantId,
                            qty: qty,
                            buy_now: 1,
                        }),
                    });

                    const data = await res.json();
                    if (data.ok) {
                        if (typeof window.triggerAddToCartTracking === 'function' && data.tracked_event) {
                            window.triggerAddToCartTracking(data.tracked_event, {
                                id: @json((string) $product->id),
                                name: @json($product->name),
                                category: @json($product->category?->name ?? ''),
                            });
                        }
                        if (window.StoreModal) {
                            window.StoreModal.openCheckoutModal(data.checkout_data || null);
                        } else {
                            window.location.href = @json(route('checkout.create'));
                        }
                    } else {
                        window.showToast(data.message || 'অর্ডার সম্পন্ন করা সম্ভব হয়নি।', 'error');
                    }
                } catch (err) {
                    // Fallback to submitting the standard form
                    document.getElementById('single-product-form')?.submit();
                } finally {
                    buyNowBtn.disabled = false;
                    buyNowBtn.innerHTML = origHtml;
                }
            });
        })();
    </script>

    {{-- Preserved Storefront Tracking Scripts --}}
    <script>
        (() => {
            const productData = {
                id: @json((string) $product->id),
                name: @json($product->name),
                category: @json($product->category?->name ?? ''),
                price: {{ (float) $product->price }},
                currency: 'BDT'
            };

            const eventId = @json($trackedEvent['event_id'] ?? ('view_'.\Illuminate\Support\Str::uuid()->toString()));

            window.__tracked_events = window.__tracked_events || {};
            if (window.__tracked_events[eventId]) {
                return;
            }
            window.__tracked_events[eventId] = true;

            // Meta Pixel ViewContent
            if (typeof fbq === 'function') {
                fbq('track', 'ViewContent', {
                    content_name: productData.name,
                    content_category: productData.category,
                    content_ids: [productData.id],
                    content_type: 'product',
                    value: productData.price,
                    currency: productData.currency
                }, {
                    eventID: eventId
                });
            }

            // TikTok Pixel ViewContent
            if (typeof ttq === 'object' && typeof ttq.track === 'function') {
                ttq.track('ViewContent', {
                    content_id: productData.id,
                    content_type: 'product',
                    content_name: productData.name,
                    quantity: 1,
                    price: productData.price,
                    value: productData.price,
                    currency: productData.currency
                }, {
                    event_id: eventId
                });
            }

            // Google dataLayer view_item
            window.dataLayer = window.dataLayer || [];
            window.dataLayer.push({ ecommerce: null });
            window.dataLayer.push({
                event: 'view_item',
                event_id: eventId,
                ecommerce: {
                    currency: productData.currency,
                    value: productData.price,
                    items: [{
                        item_id: productData.id,
                        item_name: productData.name,
                        item_category: productData.category,
                        price: productData.price,
                        quantity: 1
                    }]
                }
            });
        })();
    </script>
@endpush
